    PERS string st_RRC_RobotWare:="7.19.3";
    PERS string st_RRC_ControllerID:="15000-100688";
    PERS string st_RRC_WAN_IP:="192.168.50.240";
    PERS string st_RRC_ControllerLang:="de";
    PERS string st_RRC_SystemName:="15000-100688";

